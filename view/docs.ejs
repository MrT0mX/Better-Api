    <!-- NAVBAR -->
    <section id="content">
      <!-- NAVBAR -->
      <nav>
        <button class="toggle-sidebar" type="button" aria-label="মেনু খুলুন" aria-expanded="false"><i class="bx bx-menu"></i></button>
        <form id="api-search-form" role="search">
          <div class="form-group">
            <input id="api-search" type="search" placeholder="API এন্ডপয়েন্ট খুঁজুন..." autocomplete="off" aria-label="API এন্ডপয়েন্ট খুঁজুন" />
            <i class="bx bx-search icon"></i>
          </div>
        </form>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="থিম বদলান" title="থিম বদলান"><i class="bx bx-sun"></i></button>
        <div class="profile">
          <button class="profile-trigger" type="button" aria-label="অ্যাকাউন্ট মেনু খুলুন" aria-expanded="false"><%= username.charAt(0).toUpperCase() %></button>
          <ul class="profile-link">
            <li>
              <a href="#account-key"><i class="bx bxs-key"></i> API key</a>
            </li>
            <li>
              <a href="/logout"><i class="bx bxs-log-out-circle"></i> লগআউট</a>
            </li>
          </ul>
        </div>
      </nav>
      <!-- NAVBAR -->

      <!-- MAIN -->
      <main>
        <div class="dashboard-heading">
          <div>
            <p class="eyebrow">আপনার API কর্মক্ষেত্র</p>
            <h1 class="title">স্বাগতম, <%= username %></h1>
            <p class="dashboard-subtitle">এপিআই, ব্যবহার ও অ্যাকাউন্ট—সবকিছু এক জায়গায়।</p>
          </div>
          <div class="dashboard-actions">
            <a class="action-button docs-link" href="#endpoint-directory"><i class="bx bx-grid-alt"></i><span>এন্ডপয়েন্ট দেখুন</span></a>
            <div class="service-state" id="service-state" data-health-url="/healthz" role="status" aria-live="polite">
            <span class="state-dot"></span>
            <span class="state-label">সার্ভিস পরীক্ষা হচ্ছে</span>
            <button id="refresh-health" class="icon-button health-refresh" type="button" aria-label="সার্ভিসের অবস্থা আবার পরীক্ষা করুন" title="আবার পরীক্ষা করুন"><i class="bx bx-refresh"></i></button>
            </div>
          </div>
        </div>
        <!-- Alert Warning Verify -->
        <% if(!verified){ %>
        <div class="alert">
          <div class="msg">
            মনোযোগ: API ব্যবহার করতে আগে আপনার ইমেইল যাচাই করুন।
            <a class="alert-a" href="/send-verification-email"
              >যাচাইকরণ ইমেইল পাঠান</a
            >
          </div>
        </div>
        <% } %>
        <!-- Alert Success -->
        <% if( success_messages !="" ){ %>
        <div class="alert-success">
          <div class="msg">সফল: <%= success_messages %>.</div>
        </div>
        <% } %>
        <!-- Alert Error -->
        <% if( error_messages !="" ){ %>
        <div class="alert">
          <div class="msg">সমস্যা: <%= error_messages %>.</div>
        </div>
        <% } %>

        <section class="info-data" aria-label="অ্যাকাউন্টের পরিসংখ্যান">
          <div class="card metric-card">
            <div class="head">
              <div>
                <p>মোট API ব্যবহারকারী</p>
                <h2><%= totalUsers.toLocaleString() %></h2>
              </div>
              <i class="bx bx-user-check icon"></i>
            </div>
          </div>
          <div class="card metric-card">
            <div class="head">
              <div>
                <p>আজকের মোট অনুরোধ</p>
                <h2><%= RequestToday.toLocaleString() %></h2>
              </div>
              <i class="bx bx-repost bx-rotate-90 icon"></i>
            </div>
          </div>
          <div class="card metric-card">
            <div class="head">
              <div>
                <p>আপনার বাকি অনুরোধ</p>
                <h2><%= limit.toLocaleString() %></h2>
              </div>
              <i class="bx bx-pulse icon"></i>
            </div>
          </div>
          <div class="card metric-card">
            <div class="head">
              <div>
                <p>অ্যাকাউন্ট যাচাই</p>
                <h2><%= verified ? 'যাচাইকৃত' : 'বাকি' %></h2>
              </div>
              <i class="bx bx-badge-check icon"></i>
            </div>
          </div>
        </section>

        <section class="workspace-grid" aria-label="API টুলস">
          <article class="tool-panel key-panel" id="account-key">
            <div class="panel-heading">
              <div>
                <p class="eyebrow">নিরাপদ পরিচিতি</p>
                <h2>আপনার API key</h2>
              </div>
              <i class="bx bx-key panel-icon" aria-hidden="true"></i>
            </div>
            <div class="key-control">
              <input id="api-key-value" type="password" value="<%= apikey %>" readonly autocomplete="off" aria-label="আপনার API key" />
              <button id="toggle-api-key" class="icon-button" type="button" aria-label="API key দেখান" title="API key দেখান"><i class="bx bx-show"></i></button>
              <button id="copy-api-key" class="action-button" type="button"><i class="bx bx-copy"></i><span>কপি</span></button>
            </div>
            <p class="panel-hint"><i class="bx bx-shield-quarter"></i> API key গোপন রাখুন—এটি আপনার অ্যাকাউন্টের পরিচয়।</p>
          </article>

          <article class="tool-panel console-panel">
            <div class="panel-heading">
              <div>
                <p class="eyebrow">দ্রুত পরীক্ষা</p>
                <h2>API অনুরোধ চালান</h2>
              </div>
              <span class="method-badge">GET</span>
            </div>
            <form id="api-playground">
              <label for="api-url">এন্ডপয়েন্টের পথ ও প্যারামিটার</label>
              <div class="request-control">
                <input id="api-url" type="text" value="/test" placeholder="/api/tools/ebase64?text=hello" spellcheck="false" required aria-describedby="api-url-help" />
                <button class="action-button run-button" type="submit"><i class="bx bx-play"></i><span>চালান</span></button>
              </div>
              <p id="api-url-help" class="panel-hint">পাশের তালিকা থেকে এন্ডপয়েন্ট বাছুন অথবা `/test` দিয়ে শুরু করুন।</p>
            </form>
            <div class="response-heading"><span>সার্ভারের উত্তর</span><span id="response-meta">প্রস্তুত</span></div>
            <div class="response-actions">
              <span id="response-message" role="status" aria-live="polite">এন্ডপয়েন্ট চালালে উত্তর এখানে দেখাবে।</span>
              <button id="copy-curl" class="text-button" type="button"><i class="bx bx-copy"></i> cURL কপি</button>
            </div>
            <pre id="api-response" aria-live="polite">এন্ডপয়েন্ট নির্বাচন করে চালান।</pre>
          </article>
        </section>

        <section class="ai-workspace" aria-labelledby="ai-workspace-title">
          <div class="directory-heading ai-heading">
            <div>
              <p class="eyebrow">AI WORKSPACE</p>
              <h2 id="ai-workspace-title">AI chat ও teaching agent</h2>
              <p class="dashboard-subtitle">নিজের server-configured provider দিয়ে প্রশ্ন করুন বা শেখার অনুশীলন করুন।</p>
            </div>
            <span id="ai-provider-status" class="ai-provider-status" role="status" aria-live="polite">Provider পরীক্ষা হচ্ছে…</span>
          </div>
          <form id="ai-playground" class="ai-playground">
            <div class="ai-controls">
              <label>Provider
                <select id="ai-provider" name="provider">
                  <option value="openai">OpenAI</option>
                  <option value="gemini">Google Gemini</option>
                  <option value="anthropic">Anthropic Claude</option>
                  <option value="openrouter">OpenRouter</option>
                  <option value="deepseek">DeepSeek</option>
                  <option value="groq">Groq</option>
                  <option value="mistral">Mistral</option>
                  <option value="llm">Custom OpenAI-compatible LLM</option>
                </select>
              </label>
              <label>Model
                <input id="ai-model" name="model" type="text" maxlength="100" placeholder="provider default" autocomplete="off" />
              </label>
              <label>Mode
                <select id="ai-mode" name="mode">
                  <option value="chat">সাধারণ chat</option>
                  <option value="teach">শেখার সহায়ক</option>
                </select>
              </label>
            </div>
            <label for="ai-message">আপনার প্রশ্ন</label>
            <textarea id="ai-message" name="message" rows="4" maxlength="12000" placeholder="কোনো বিষয় সহজভাবে বুঝিয়ে বলুন..." required></textarea>
            <div class="ai-submit-row">
              <span class="panel-hint">এই request আপনার API key quota থেকে ১টি ব্যবহার করবে। AI provider key server-এ configure করা থাকতে হবে।</span>
              <button class="action-button run-button" id="ai-submit" type="submit"><i class="bx bx-send"></i><span>পাঠান</span></button>
            </div>
          </form>
          <pre id="ai-response" class="ai-response" aria-live="polite">AI response এখানে দেখাবে।</pre>
        </section>

        <section class="endpoint-directory" id="endpoint-directory" aria-labelledby="endpoint-title">
          <div class="directory-heading">
            <div>
              <p class="eyebrow">API লাইব্রেরি</p>
              <h2 id="endpoint-title">সব এন্ডপয়েন্ট</h2>
              <p class="dashboard-subtitle">যেকোনো এন্ডপয়েন্টে ক্লিক করলে সেটি পরীক্ষার ঘরে যোগ হবে।</p>
            </div>
            <span class="endpoint-count" id="endpoint-count" aria-live="polite">এন্ডপয়েন্ট গণনা হচ্ছে…</span>
          </div>
          <div class="endpoint-grid" id="endpoint-grid"></div>
          <div class="empty-search" id="empty-search" hidden>
            <i class="bx bx-search-alt"></i>
            <p>কোনো এন্ডপয়েন্ট পাওয়া যায়নি। অন্য শব্দ দিয়ে খুঁজুন।</p>
          </div>
        </section>
      </main>
      <!-- MAIN -->
    </section>
    <!-- NAVBAR -->

    <script src="/js/docs/script.js"></script>
    <script src="/js/docs/ai.js"></script>
  </body>
