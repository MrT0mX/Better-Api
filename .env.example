# Better-Api environment example
# Copy this to .env and fill actual values.

mongodb="mongodb://127.0.0.1:27017/better-api"
sendemail="your.smtp.email@example.com"
fromsendemail="your.smtp.email@example.com"
sendpwmail="your-smtp-password"
recaptcha_key_1="your_recaptcha_key_1"
recaptcha_key_2="your_recaptcha_key_2"
CUTTLY_API_KEYS=""
BITLY_API_KEYS=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME="MrTomXxX API"
DEEPSEEK_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""
SESSION_SECRET=""
PORT=8080
LIMIT_APIKEY=200
CREATOR="MrTom乂x乂"
USE_TEMP_EMAIL=true
servicesmtp="Zoho"
domain="localhost:8080"
# Optional first-run admin bootstrap. Use a NEW secret (at least 12 chars);
# never put real credentials in this template or commit them to Git.
ADMIN_USERNAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Stable master key used to encrypt credentials saved from the admin settings page.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SETTINGS_ENCRYPTION_KEY=""
